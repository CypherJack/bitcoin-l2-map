---
const { t } = Astro.props;
---
<div class="info-bar" id="info-bar">
  <div class="info-bar-col">
    <h3>{t.readMap}</h3>
    <p>{t.readMapBody}<em>{t.readMapEm}</em>.</p>
  </div>
  <div class="info-bar-col">
    <h3>{t.legendTitle}</h3>
    <div class="legend-row"><svg width="32" height="6"><line x1="0" y1="3" x2="32" y2="3" stroke="#aaa" stroke-width="1" /></svg><span>{t.legendNative}</span></div>
    <div class="legend-row"><svg width="32" height="6"><line x1="0" y1="3" x2="32" y2="3" stroke="#aaa" stroke-width="1" stroke-dasharray="4 4" /></svg><span>{t.legendFederated}</span></div>
    <div class="legend-row"><svg width="32" height="6"><line x1="0" y1="3" x2="32" y2="3" stroke="#aaa" stroke-width="1" stroke-dasharray="1.5 4" /></svg><span>{t.legendLN}</span></div>
    <div class="legend-row"><svg width="32" height="6"><line x1="0" y1="3" x2="32" y2="3" stroke="#aaa" stroke-width="1" stroke-dasharray="10 5" /></svg><span>{t.legendCrypto}</span></div>
  </div>
</div>
